{
  "theme": {
    "extend": {
      "colors": {
        "bg": {
          "primary": "#12141C",
          "surface": "#1C1F2B",
          "surface-raised": "#242838"
        },
        "border": {
          "subtle": "#2E3346"
        },
        "text": {
          "primary": "#F1F2F6",
          "muted": "#8B90A3"
        },
        "state": {
          "healthy": "#4ADE80",
          "wounded": "#FBBF24",
          "critical": "#F87171",
          "dying": "#7C1D2E",
          "buff": "#38BDF8",
          "debuff": "#C084FC"
        },
        "accent": {
          "turn": "#FACC15"
        }
      },
      "fontFamily": {
        "sans": ["Inter", "sans-serif"]
      },
      "fontSize": {
        "stat-lg": ["1.5rem", { "lineHeight": "1.2", "fontWeight": "600", "fontFeatureSettings": "'tnum'" }],
        "stat-md": ["1.125rem", { "lineHeight": "1.2", "fontWeight": "600", "fontFeatureSettings": "'tnum'" }]
      }
    }
  },
  "principle": "Aucune couleur n'est utilisée 'en dur' dans les composants ; toute référence de couleur passe par un token nommé (ex. bg-state-critical, text-accent-turn), garantissant un point de vérité unique pour toute évolution future de la charte."
}
